# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: gemini | openai | sentence_transformers
# Nhóm dùng gemini-embedding-001 (3072 chiều, gọi qua API, không phải tải model).
# Muốn chạy offline thì đổi sang sentence_transformers + BAAI/bge-m3, nhưng phải
# xoá chroma_db/ và index lại vì số chiều vector khác nhau.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
